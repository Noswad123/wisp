# shellcheck shell=bash
# shellcheck disable=SC2207

_wisp_completion() {
  local cur prev
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD - 1]}"

  if [[ $COMP_CWORD -eq 1 ]]; then
    local commands="run shell summon action actions palette bindings daemon doctor rules nvim vim yazi less bash zsh waystone help --help -h --terminal -t"
    COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
    return 0
  fi

  if [[ $COMP_CWORD -eq 2 && ${COMP_WORDS[1]} == "actions" ]]; then
    COMPREPLY=( $(compgen -W "list init path" -- "$cur") )
    return 0
  fi

  if [[ $COMP_CWORD -eq 2 && ${COMP_WORDS[1]} == "rules" ]]; then
    COMPREPLY=( $(compgen -W "aerospace hyprland" -- "$cur") )
    return 0
  fi

  if [[ $COMP_CWORD -eq 2 && ${COMP_WORDS[1]} == "bindings" ]]; then
    COMPREPLY=( $(compgen -W "aerospace hyprland" -- "$cur") )
    return 0
  fi

  if [[ $COMP_CWORD -eq 2 && ${COMP_WORDS[1]} == "daemon" ]]; then
    COMPREPLY=( $(compgen -W "start serve status stop reload" -- "$cur") )
    return 0
  fi

  case "$cur" in
    --*)
      COMPREPLY=( $(compgen -W "--id --title --dir --path --" -- "$cur") )
      return 0
      ;;
  esac

  case "$prev" in
    --id|--title)
      COMPREPLY=()
      ;;
    --dir|--path)
      COMPREPLY=( $(compgen -f -- "$cur") )
      ;;
    nvim|vim|less|yazi)
      COMPREPLY=( $(compgen -f -- "$cur") )
      ;;
    *)
      COMPREPLY=( $(compgen -f -- "$cur") )
      ;;
  esac
}

complete -F _wisp_completion wisp
