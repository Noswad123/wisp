#compdef wisp

_wisp() {
  if (( CURRENT == 3 )) && [[ ${words[2]} == (palette|hint) ]]; then
    _values 'Palette command' \
      'show[show the native prefix Palette]' \
      'close[close the native prefix Palette]' \
      'text[print the Palette text]'
    return
  fi

  local -a commands
  commands=(
    'run:open a command in a Wisp surface'
    'shell:open a shell in a Wisp surface'
    'summon:open or focus a named Wisp surface'
    'action:run an action from the Wisp catalog'
    'actions:inspect or initialize the Wisp action catalog'
    'palette:show, close, or print the native prefix Palette'
    'menu:open the terminal/fzf Wisp Menu'
    'show:reveal the Hyprland utility overlay'
    'hide:hide the Hyprland overlay without closing applications'
    'bindings:print hotkey binding snippets'
    'hint:compatibility alias for palette'
    'daemon:manage the Wisp daemon'
    'doctor:print Wisp diagnostics'
    'rules:print window-manager rule snippets'
    'nvim:open Neovim in a floating terminal'
    'vim:open Vim in a floating terminal'
    'less:open less in a floating terminal'
    'bash:open Bash in a floating terminal'
    'zsh:open Zsh in a floating terminal'
    'waystone:open Waystone in a floating terminal'
  )

  _arguments -C \
    '(-h --help help)'{-h,--help,help}'[show help]' \
    '(-t --terminal)'{-t,--terminal}'[open a floating terminal]' \
    '--id[stable Wisp surface id]:id:' \
    '--title[human title label]:title:' \
    '--dir[working directory]:directory:_files -/' \
    '--path[path used to infer title and working directory]:path:_files' \
    '--layout[explicit surface layout]:layout:(floating fullscreen)' \
    '1:command: _describe -t commands "commands" commands' \
    '*::arguments:_normal'
}

_wisp "$@"
