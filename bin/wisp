#!/usr/bin/env bash
set -euo pipefail

# Open a command in a Wisp utility surface.

WISP_COMMAND="$(basename "$0")"
WISP_PATH="${WISP_PATH:-}"
WISP_DIR="${WISP_DIR:-}"
WISP_ID="${WISP_ID:-}"
WISP_TITLE="${WISP_TITLE:-}"
WISP_SHELL="${WISP_SHELL:-${SHELL:-/bin/zsh}}"
WISP_BACKEND="${WISP_BACKEND:-auto}"
WISP_HYPRLAND_WORKSPACE="${WISP_HYPRLAND_WORKSPACE:-wisp}"
WISP_CONFIG_HOME="${WISP_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/wisp}"
WISP_ACTIONS_PATH="${WISP_ACTIONS_PATH:-$WISP_CONFIG_HOME/actions.toml}"
WISP_CACHE_HOME="${WISP_CACHE_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/wisp}"
WISP_LOG_PATH="${WISP_LOG_PATH:-$WISP_CACHE_HOME/wisp.log}"
WISP_SELF="${WISP_SELF:-${BASH_SOURCE[0]}}"

MODE="run"
TERMINAL_MODE=0
SURFACE_ID=""
WINDOW_TITLE=""
TARGET_PATH="$WISP_PATH"
WORK_DIR=""
COMMAND=""
COMMAND_ARGS=()
ORIGINAL_ARGS=()
PARSED_OPTION_COUNT=0

usage() {
  cat <<EOF
Usage:
  $WISP_COMMAND <command> [args...]
  $WISP_COMMAND --terminal
  $WISP_COMMAND run [--id ID] [--title TITLE] [--dir DIR] [--path PATH] -- <command> [args...]
  $WISP_COMMAND shell [--id ID] [--title TITLE] [--dir DIR]
  $WISP_COMMAND summon <id> [--title TITLE] [--dir DIR] [--path PATH] -- <command> [args...]
  $WISP_COMMAND action <id>
  $WISP_COMMAND actions [list|init|path]
  $WISP_COMMAND palette
  $WISP_COMMAND doctor
  $WISP_COMMAND rules [aerospace|hyprland]

Environment:
  WISP_ID       Stable surface id. Defaults to command/title-derived id.
  WISP_TITLE    Human title label. Wisp prefixes non-wisp titles as wisp:<id>: <label>.
  WISP_DIR      Working directory override.
  WISP_PATH     Path used to infer title and working directory.
  WISP_SHELL    Shell for --terminal/shell. Defaults to SHELL, then /bin/zsh.
  WISP_BACKEND  Backend override: auto, aerospace, hyprland, kitty.
  WISP_ACTIONS_PATH  Action catalog path. Defaults to ~/.config/wisp/actions.toml.
  WISP_LOG_PATH  Log path for detached palette actions. Defaults to ~/.cache/wisp/wisp.log.
EOF
}

notify() {
  local message="$1"
  if command -v osascript >/dev/null 2>&1; then
    osascript -e "display notification \"$message\" with title \"$WISP_COMMAND\"" >/dev/null 2>&1 || true
  fi
}

log_line() {
  mkdir -p "$(dirname "$WISP_LOG_PATH")" 2>/dev/null || true
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$WISP_LOG_PATH" 2>/dev/null || true
}

die() {
  printf '%s: %s\n' "$WISP_COMMAND" "$1" >&2
  exit "${2:-1}"
}

slugify() {
  local value="$1"
  value="${value##*/}"
  value="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]_.-' '-')"
  value="${value##-}"
  value="${value%%-}"
  printf '%s' "${value:-surface}"
}

rules_aerospace() {
  cat <<'EOF'
# Add this to your Aerospace config so Wisp windows are classified by identity
# instead of by post-launch focus races.
on-window-detected = [
    { if.app-id = 'net.kovidgoyal.kitty', if.window-title-regex-substring = '^wisp:', run = 'layout floating' },
]
EOF
}

rules_hyprland() {
  cat <<'EOF'
# No static Hyprland rule is required. The Hyprland backend launches Wisp with
# one-shot rules equivalent to:
#
# hyprctl dispatch exec '[workspace special:wisp; float; size 900 600; center] kitty --class wisp-<id> --title wisp:<id>:<label> ...'
#
# Override the special workspace name with WISP_HYPRLAND_WORKSPACE.
EOF
}

doctor() {
  printf 'wisp: doctor\n'
  printf '  os: %s\n' "$(uname -s 2>/dev/null || printf unknown)"

  if [[ -d /Applications/kitty.app ]] || command -v kitty >/dev/null 2>&1; then
    printf '  kitty: ok\n'
  else
    printf '  kitty: missing\n'
  fi

  if command -v aerospace >/dev/null 2>&1; then
    printf '  aerospace: ok\n'
    printf '  recommended rule: %s rules aerospace\n' "$WISP_COMMAND"
  else
    printf '  aerospace: not found\n'
  fi

  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && command -v hyprctl >/dev/null 2>&1; then
    printf '  hyprland: detected\n'
    if command -v python3 >/dev/null 2>&1; then
      printf '  hyprland summon lookup: ok\n'
    else
      printf '  hyprland summon lookup: missing python3\n'
    fi
  else
    printf '  hyprland: not detected\n'
  fi

  if [[ -f "$WISP_ACTIONS_PATH" ]]; then
    printf '  actions: %s\n' "$WISP_ACTIONS_PATH"
  else
    printf '  actions: missing (%s)\n' "$WISP_ACTIONS_PATH"
  fi

  printf '  log: %s\n' "$WISP_LOG_PATH"

  if command -v fzf >/dev/null 2>&1; then
    printf '  fzf: ok\n'
  else
    printf '  fzf: missing\n'
  fi

  printf '  selected backend: %s\n' "$(select_backend 2>/dev/null || printf unavailable)"
}

need_python() {
  command -v python3 >/dev/null 2>&1 || die 'python3 is required for Wisp actions'
}

actions_python() {
  need_python
  python3 - "$@" <<'PY'
from __future__ import annotations

import os
import shlex
import sys
import tomllib
from pathlib import Path


def expand(value: str) -> str:
    return os.path.expandvars(os.path.expanduser(value))


def load_actions(path: str) -> list[dict]:
    config_path = Path(expand(path))
    if not config_path.exists():
        raise SystemExit(f"actions file not found: {config_path}")

    with config_path.open("rb") as handle:
        config = tomllib.load(handle)

    actions = config.get("action", [])
    if not isinstance(actions, list):
        raise SystemExit("actions file must contain [[action]] entries")
    return [action for action in actions if isinstance(action, dict)]


def normalized_command(action: dict) -> list[str]:
    command = action.get("command")
    if isinstance(command, str):
        return ["sh", "-lc", command]
    if isinstance(command, list) and all(isinstance(item, str) for item in command):
        return [expand(item) for item in command]
    raise SystemExit(f"action {action.get('id', '<unknown>')!r} must define command as a string or string array")


def find_action(actions: list[dict], action_id: str) -> dict:
    for action in actions:
        if action.get("id") == action_id:
            return action
    raise SystemExit(f"action not found: {action_id}")


command = sys.argv[1]
path = sys.argv[2]

if command == "list":
    for action in load_actions(path):
        action_id = str(action.get("id") or "").strip()
        if not action_id:
            continue
        title = str(action.get("title") or action_id)
        kind = str(action.get("kind") or "summon")
        print(f"{action_id}\t{title}\t{kind}")
elif command == "shell":
    action = find_action(load_actions(path), sys.argv[3])
    action_id = str(action.get("id") or sys.argv[3])
    title = str(action.get("title") or action_id)
    kind = str(action.get("kind") or "summon")
    if kind not in {"run", "summon", "shell"}:
        raise SystemExit(f"unsupported action kind for {action_id}: {kind}")
    command_args = [] if kind == "shell" else normalized_command(action)

    print(f"ACTION_ID={shlex.quote(action_id)}")
    print(f"ACTION_TITLE={shlex.quote(title)}")
    print(f"ACTION_KIND={shlex.quote(kind)}")
    print("ACTION_COMMAND=(" + " ".join(shlex.quote(arg) for arg in command_args) + ")")
else:
    raise SystemExit(f"unknown actions command: {command}")
PY
}

actions_sample() {
  cat <<'EOF'
[[action]]
id = "scratch"
title = "Scratch Notes"
kind = "summon"
command = ["nvim", "~/Projects/darkness/introspection/scratch.md"]

[[action]]
id = "aero"
title = "Aerospace Manager"
kind = "summon"
command = ["zsh", "-lc", "aeros"]

[[action]]
id = "hpm"
title = "Maintain Panes"
kind = "summon"
command = ["hpm"]

[[action]]
id = "terminal"
title = "Floating Terminal"
kind = "shell"
command = []
EOF
}

actions_init() {
  if [[ -e "$WISP_ACTIONS_PATH" ]]; then
    die "actions file already exists: $WISP_ACTIONS_PATH"
  fi

  mkdir -p "$(dirname "$WISP_ACTIONS_PATH")"
  actions_sample > "$WISP_ACTIONS_PATH"
  printf 'created %s\n' "$WISP_ACTIONS_PATH"
}

actions_list() {
  actions_python list "$WISP_ACTIONS_PATH"
}

load_action() {
  local action_id="$1"
  local assignments
  assignments="$(actions_python shell "$WISP_ACTIONS_PATH" "$action_id")"
  eval "$assignments"

  # shellcheck disable=SC2153 # ACTION_* variables are produced by actions_python above.
  WISP_ID="$ACTION_ID"
  # shellcheck disable=SC2153 # ACTION_* variables are produced by actions_python above.
  WISP_TITLE="$ACTION_TITLE"
  # shellcheck disable=SC2153 # ACTION_* variables are produced by actions_python above.
  MODE="$ACTION_KIND"

  if [[ "$ACTION_KIND" == "shell" ]]; then
    TERMINAL_MODE=1
    COMMAND="$WISP_SHELL"
    COMMAND_ARGS=()
  else
    COMMAND="${ACTION_COMMAND[0]}"
    COMMAND_ARGS=("${ACTION_COMMAND[@]:1}")
  fi
}

palette_body() {
  command -v fzf >/dev/null 2>&1 || die 'fzf is required for wisp palette'

  local selection action_id
  selection="$(actions_list | fzf --prompt='Wisp> ' --delimiter=$'\t' --with-nth=2,3 --height=100% --border --ansi)" || exit 0
  action_id="${selection%%$'\t'*}"
  [[ -n "$action_id" ]] || exit 0

  log_line "palette selected action=$action_id"
  log_line "palette launching action=$action_id"
  "$WISP_SELF" action "$action_id" >> "$WISP_LOG_PATH" 2>&1
  exit 0
}

start_palette() {
  MODE="run"
  WISP_ID="palette"
  WISP_TITLE="Wisp Palette"
  COMMAND="$WISP_SELF"
  COMMAND_ARGS=("_palette")
}

parse_common_option() {
  PARSED_OPTION_COUNT=0

  case "${1:-}" in
    --id)
      [[ $# -ge 2 ]] || die '--id requires a value'
      WISP_ID="$2"
      PARSED_OPTION_COUNT=2
      return 0
      ;;
    --title)
      [[ $# -ge 2 ]] || die '--title requires a value'
      WISP_TITLE="$2"
      PARSED_OPTION_COUNT=2
      return 0
      ;;
    --dir)
      [[ $# -ge 2 ]] || die '--dir requires a value'
      WISP_DIR="$2"
      PARSED_OPTION_COUNT=2
      return 0
      ;;
    --path)
      [[ $# -ge 2 ]] || die '--path requires a value'
      WISP_PATH="$2"
      TARGET_PATH="$2"
      PARSED_OPTION_COUNT=2
      return 0
      ;;
  esac

  return 1
}

parse_command_args() {
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --)
        shift
        break
        ;;
      --id|--title|--dir|--path)
        parse_common_option "$@"
        shift "$PARSED_OPTION_COUNT"
        ;;
      *)
        break
        ;;
    esac
  done

  [[ $# -gt 0 ]] || die 'missing command'
  COMMAND="$1"
  shift
  COMMAND_ARGS=("$@")
}

parse_shell_args() {
  TERMINAL_MODE=1
  MODE="shell"
  COMMAND="$WISP_SHELL"

  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --)
        shift
        [[ $# -eq 0 ]] || die 'shell does not accept command arguments; use run instead'
        break
        ;;
      --id|--title|--dir|--path)
        parse_common_option "$@"
        shift "$PARSED_OPTION_COUNT"
        ;;
      *)
        die "unknown shell option: $1"
        ;;
    esac
  done
}

parse_args() {
  [[ $# -gt 0 ]] || { usage >&2; exit 1; }

  case "${1:-}" in
    -h|--help|help)
      usage
      exit 0
      ;;
    doctor)
      doctor
      exit 0
      ;;
    _palette)
      palette_body
      ;;
    _launch_action)
      shift
      [[ $# -gt 0 ]] || die '_launch_action requires an id'
      sleep 0.2
      log_line "palette launching action=$1"
      load_action "$1"
      ;;
    palette)
      start_palette
      ;;
    action)
      shift
      [[ $# -gt 0 ]] || die 'action requires an id'
      load_action "$1"
      ;;
    actions)
      shift
      case "${1:-list}" in
        list)
          actions_list
          exit 0
          ;;
        init)
          actions_init
          exit 0
          ;;
        path)
          printf '%s\n' "$WISP_ACTIONS_PATH"
          exit 0
          ;;
        *)
          die "unknown actions command: $1" 2
          ;;
      esac
      ;;
    rules)
      shift
      case "${1:-aerospace}" in
        aerospace)
          rules_aerospace
          exit 0
          ;;
        hyprland)
          rules_hyprland
          exit 0
          ;;
        *)
          die "unknown rules backend: $1" 2
          ;;
      esac
      ;;
    run)
      MODE="run"
      shift
      parse_command_args "$@"
      ;;
    shell)
      shift
      parse_shell_args "$@"
      ;;
    summon)
      MODE="summon"
      shift
      [[ $# -gt 0 ]] || die 'summon requires an id'
      WISP_ID="$1"
      shift
      parse_command_args "$@"
      ;;
    -t|--terminal)
      shift
      [[ $# -eq 0 ]] || die "--terminal does not accept arguments; use '$WISP_COMMAND <shell> [args...]' instead"
      TERMINAL_MODE=1
      MODE="shell"
      COMMAND="$WISP_SHELL"
      ;;
    *)
      MODE="run"
      COMMAND="$1"
      shift
      COMMAND_ARGS=("$@")
      ;;
  esac
}

resolve_command() {
  local resolved_command
  resolved_command="$(command -v "$COMMAND" 2>/dev/null || true)"
  if [[ -z "$resolved_command" && -x "$COMMAND" ]]; then
    resolved_command="$COMMAND"
  fi

  if [[ -z "$resolved_command" ]]; then
    notify "$COMMAND was not found on PATH"
    die "command not found: $COMMAND"
  fi

  if [[ "$TERMINAL_MODE" -eq 1 ]]; then
    ORIGINAL_ARGS=("$COMMAND")
  else
    ORIGINAL_ARGS=("$COMMAND" "${COMMAND_ARGS[@]}")
  fi
}

infer_target_path() {
  if [[ -z "$TARGET_PATH" && ${#COMMAND_ARGS[@]} -ge 1 ]]; then
    local candidate="${COMMAND_ARGS[0]}"
    if [[ -n "$candidate" && "$candidate" != -* ]]; then
      TARGET_PATH="$candidate"
    fi
  fi
}

resolve_work_dir() {
  local default_work_dir default_display_path

  if [[ -n "$TARGET_PATH" ]]; then
    if [[ -d "$TARGET_PATH" ]]; then
      default_work_dir="$TARGET_PATH"
      default_display_path="$TARGET_PATH"
    else
      default_work_dir="$(dirname "$TARGET_PATH")"
      default_display_path="$TARGET_PATH"
    fi
  else
    default_work_dir="$PWD"
    default_display_path=""
  fi

  WORK_DIR="${WISP_DIR:-$default_work_dir}"

  if [[ -n "$default_display_path" && "$default_display_path" == "$HOME"/* ]]; then
    # shellcheck disable=SC2088 # This is a display label, not a path to expand.
    default_display_path="~/${default_display_path#"$HOME"/}"
  fi

  local default_label
  if [[ -n "$default_display_path" ]]; then
    default_label="$default_display_path"
  elif [[ "$TERMINAL_MODE" -eq 1 ]]; then
    default_label="terminal"
  else
    default_label="$COMMAND"
  fi

  if [[ -z "$WISP_ID" ]]; then
    if [[ -n "$WISP_TITLE" ]]; then
      SURFACE_ID="$(slugify "$WISP_TITLE")"
    elif [[ "$TERMINAL_MODE" -eq 1 ]]; then
      SURFACE_ID="terminal"
    else
      SURFACE_ID="$(slugify "$COMMAND")"
    fi
  else
    SURFACE_ID="$(slugify "$WISP_ID")"
  fi

  if [[ -n "$WISP_TITLE" ]]; then
    WINDOW_TITLE="$WISP_TITLE"
  else
    WINDOW_TITLE="$default_label"
  fi

  if [[ "$WINDOW_TITLE" != wisp:* ]]; then
    WINDOW_TITLE="wisp:$SURFACE_ID: $WINDOW_TITLE"
  fi

  [[ -d "$WORK_DIR" ]] || die "working directory does not exist: $WORK_DIR"
}

ensure_terminal() {
  if [[ ! -d /Applications/kitty.app ]] && ! command -v kitty >/dev/null 2>&1; then
    notify 'kitty was not found'
    exit 1
  fi
}

hyprland_available() {
  [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && command -v hyprctl >/dev/null 2>&1
}

select_backend() {
  case "$WISP_BACKEND" in
    auto)
      if hyprland_available; then
        printf 'hyprland'
      elif [[ "$(uname -s 2>/dev/null || true)" == 'Darwin' ]]; then
        printf 'aerospace'
      else
        printf 'kitty'
      fi
      ;;
    aerospace|hyprland|kitty)
      printf '%s' "$WISP_BACKEND"
      ;;
    *)
      die "unknown backend: $WISP_BACKEND" 2
      ;;
  esac
}

focus_existing_aerospace() {
  [[ "$MODE" == "summon" ]] || return 1
  command -v aerospace >/dev/null 2>&1 || return 1

  local window_id app_id title
  while IFS='|' read -r window_id app_id title; do
    if [[ "$app_id" == 'net.kovidgoyal.kitty' && "$title" == "wisp:$SURFACE_ID:"* ]]; then
      aerospace focus --window-id "$window_id" >/dev/null 2>&1 && return 0
    fi
  done < <(aerospace list-windows --all --format '%{window-id}|%{app-bundle-id}|%{window-title}' 2>/dev/null || true)

  return 1
}

focus_existing_hyprland() {
  [[ "$MODE" == "summon" ]] || return 1
  hyprland_available || return 1
  command -v python3 >/dev/null 2>&1 || return 1

  local client_line address workspace
  client_line="$(hyprctl -j clients 2>/dev/null | python3 -c '
import json
import sys

surface_id = sys.argv[1]
prefix = f"wisp:{surface_id}:"

try:
    clients = json.load(sys.stdin)
except Exception:
    clients = []

for client in clients if isinstance(clients, list) else []:
    title = str(client.get("title") or "")
    if not title.startswith(prefix):
        continue
    workspace = client.get("workspace") or {}
    workspace_name = workspace.get("name") if isinstance(workspace, dict) else ""
    address = client.get("address") or ""
    print(f"{address}|{workspace_name or ''}")
    break
' "$SURFACE_ID")"

  [[ -n "$client_line" ]] || return 1
  IFS='|' read -r address workspace <<< "$client_line"
  [[ -n "$address" ]] || return 1

  if hyprctl dispatch focuswindow "address:$address" >/dev/null 2>&1; then
    return 0
  fi

  if [[ "$workspace" == special:* ]]; then
    hyprctl dispatch togglespecialworkspace "${workspace#special:}" >/dev/null 2>&1 || true
    hyprctl dispatch focuswindow "address:$address" >/dev/null 2>&1 && return 0
  fi

  return 1
}

launch_macos_kitty() {
  # shellcheck disable=SC2016 # The inner shell receives positional parameters below.
  open -na kitty --args \
    --detach=no \
    --single-instance=no \
    --override macos_quit_when_last_window_closed=yes \
    --title "$WINDOW_TITLE" \
    --override hide_window_decorations=no \
    --override remember_window_size=no \
    --override initial_window_width=70c \
    --override initial_window_height=38c \
    /bin/zsh -lc 'work_dir="$1"; wisp_id="$2"; wisp_role="$3"; wisp_title="$4"; shift 4; cd -- "$work_dir" && export WISP=1 WISP_ID="$wisp_id" WISP_ROLE="$wisp_role" WISP_TITLE="$wisp_title"; if command -v aerospace >/dev/null 2>&1; then aerospace layout floating >/dev/null 2>&1 || true; fi; exec "$@"' \
    wisp "$WORK_DIR" "$SURFACE_ID" "$MODE" "$WINDOW_TITLE" "${ORIGINAL_ARGS[@]}" \
    >/dev/null 2>&1 &
}

launch_fallback_kitty() {
  # shellcheck disable=SC2016 # The inner shell receives positional parameters below.
  kitty \
    --title "$WINDOW_TITLE" \
    --working-directory "$WORK_DIR" \
    /bin/sh -lc 'export WISP=1 WISP_ID="$1" WISP_ROLE="$2" WISP_TITLE="$3"; shift 3; exec "$@"' \
    sh "$SURFACE_ID" "$MODE" "$WINDOW_TITLE" "${ORIGINAL_ARGS[@]}" \
    >/dev/null 2>&1 &
}

sh_quote() {
  local value="$1"
  local escaped
  escaped=${value//\'/\'\\\'\'}
  printf "'%s'" "$escaped"
}

join_shell_args() {
  local arg joined=""
  for arg in "$@"; do
    joined+=" $(sh_quote "$arg")"
  done
  printf '%s' "${joined# }"
}

launch_hyprland_kitty() {
  hyprland_available || die 'Hyprland backend requested, but hyprctl/HYPRLAND_INSTANCE_SIGNATURE is not available'

  local inner command rules
  # shellcheck disable=SC2016 # The inner shell receives positional parameters below.
  inner='work_dir="$1"; wisp_id="$2"; wisp_role="$3"; wisp_title="$4"; shift 4; cd -- "$work_dir" && export WISP=1 WISP_ID="$wisp_id" WISP_ROLE="$wisp_role" WISP_TITLE="$wisp_title" && exec "$@"'
  command="$(join_shell_args \
    kitty \
    --class "wisp-$SURFACE_ID" \
    --title "$WINDOW_TITLE" \
    /bin/sh -lc "$inner" \
    sh "$WORK_DIR" "$SURFACE_ID" "$MODE" "$WINDOW_TITLE" "${ORIGINAL_ARGS[@]}" \
  )"
  rules="[workspace special:$WISP_HYPRLAND_WORKSPACE; float; size 900 600; center]"

  hyprctl dispatch exec "$rules $command" >/dev/null 2>&1
}

post_launch_aerospace_float() {
  command -v aerospace >/dev/null 2>&1 || return 0

  (
    for _ in {1..30}; do
      focused_window="$(aerospace list-windows --focused --format '%{app-bundle-id}|%{window-title}' 2>/dev/null || true)"
      if [[ "$focused_window" == net.kovidgoyal.kitty\|*"$WINDOW_TITLE"* ]]; then
        aerospace layout floating >/dev/null 2>&1 || true
        exit 0
      fi
      sleep 0.1
    done
  ) >/dev/null 2>&1 &
}

main() {
  local backend

  parse_args "$@"
  resolve_command
  infer_target_path
  resolve_work_dir
  ensure_terminal
  backend="$(select_backend)"

  case "$backend" in
    aerospace)
      if focus_existing_aerospace; then
        exit 0
      fi
      launch_macos_kitty
      post_launch_aerospace_float
      ;;
    hyprland)
      if focus_existing_hyprland; then
        exit 0
      fi
      launch_hyprland_kitty
      ;;
    kitty)
      launch_fallback_kitty
      ;;
    *)
      die "unsupported backend: $backend" 2
      ;;
  esac
}

main "$@"
