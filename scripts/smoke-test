#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
tmp_dir="${TMPDIR:-/tmp}/wisp-smoke.$$"
trap 'rm -rf "$tmp_dir"' EXIT
mkdir -p "$tmp_dir"

bash -n "$repo_root/completions/bash/wisp"
zsh -n "$repo_root/completions/zsh/_wisp"
go test ./...
go build -o "$tmp_dir/wisp" ./cmd/wisp
"$tmp_dir/wisp" --help >/dev/null
"$tmp_dir/wisp" doctor >/dev/null
doctor_output="$($tmp_dir/wisp doctor)"
[[ "$doctor_output" == *$'  log: '* ]]
"$tmp_dir/wisp" rules aerospace >/dev/null
"$tmp_dir/wisp" rules hyprland >/dev/null
WISP_ACTIONS_PATH="$tmp_dir/actions.toml" "$tmp_dir/wisp" actions init >/dev/null
actions_output="$(WISP_ACTIONS_PATH="$tmp_dir/actions.toml" "$tmp_dir/wisp" actions list)"
[[ "$actions_output" == *$'scratch\tScratch Notes\tsummon'* ]]
actions_path="$(WISP_ACTIONS_PATH="$tmp_dir/actions.toml" "$tmp_dir/wisp" actions path)"
[[ "$actions_path" == "$tmp_dir/actions.toml" ]]
WISP_ACTIONS_PATH="$tmp_dir/actions.toml" "$tmp_dir/wisp" bindings aerospace >/dev/null
WISP_ACTIONS_PATH="$tmp_dir/actions.toml" "$tmp_dir/wisp" bindings hyprland >/dev/null
WISP_SOCKET_PATH="$tmp_dir/wispd.sock" WISP_LOG_PATH="$tmp_dir/wisp.log" "$tmp_dir/wisp" daemon start >/dev/null
WISP_SOCKET_PATH="$tmp_dir/wispd.sock" WISP_LOG_PATH="$tmp_dir/wisp.log" "$tmp_dir/wisp" daemon status >/dev/null
WISP_SOCKET_PATH="$tmp_dir/wispd.sock" WISP_LOG_PATH="$tmp_dir/wisp.log" "$tmp_dir/wisp" daemon stop >/dev/null
if WISP_NO_DAEMON=1 "$tmp_dir/wisp" run --id smoke -- definitely-not-a-wisp-command >/dev/null 2>&1; then
  printf 'expected missing command check to fail\n' >&2
  exit 1
fi

if command -v shellcheck >/dev/null 2>&1; then
  shellcheck "$repo_root/install.sh" "$repo_root/completions/bash/wisp"
fi

printf 'wisp smoke test passed\n'
